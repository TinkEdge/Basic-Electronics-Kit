
int ldrPin = A0;
int ledPin = 9;
int ldrValue = 0;

void setup() {
  pinMode(ledPin, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  ldrValue = analogRead(ldrPin);  // Read light value
  Serial.println(ldrValue);      // Display value

  if (ldrValue < 500) {
    digitalWrite(ledPin, HIGH);  // LED ON in darkness
  } else {
    digitalWrite(ledPin, LOW);   // LED OFF in brightness
  }

  delay(100);
}
